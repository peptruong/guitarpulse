{
  "name": "@guitarpulse/core",
  "version": "1.0.0",
  "description": "GuitarPulse music engine: theory, licks, coach metrics, practice plans, trading fours, ear training",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "validate:licks": "tsx scripts/validate-licks.ts"
  },
  "license": "MIT",
  "dependencies": {
    "pitchy": "^4.1.0",
    "tonal": "^6.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@coderline/alphatab": "^1.8.4",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
