{
  "name": "@guitarpulse/web",
  "version": "1.0.0",
  "private": true,
  "description": "GuitarPulse web app: backing tracks, microphone coach, trading fours, song practice, licks, ear training",
  "scripts": {
    "dev": "node scripts/copy-vendor.mjs && next dev",
    "build": "node scripts/copy-vendor.mjs && next build",
    "start": "npx serve@14 out",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@guitarpulse/core": "^1.0.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.66.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "signalsmith-stretch": "1.3.2",
    "tone": "15.1.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
